# Asistente multi-cliente — Configuración
#
# Crea tu clave gratuita en https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Alias que Google mantiene apuntando siempre al Flash estable más reciente
GEMINI_MODEL=gemini-flash-latest

# Qué cliente está activo (debe existir en app/clientes.py)
CLIENTE_ACTIVO=jaime_duque
