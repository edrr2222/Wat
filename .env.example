# BogotáGuía — Configuración
#
# Crea tu clave gratuita en https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Opcional — cambia el modelo si quieres probar otro.
# gemini-flash-latest es un alias que Google mantiene apuntando siempre
# al modelo Flash estable más reciente (evita que se rompa cuando
# retiran un modelo específico, como pasó con gemini-2.5-flash).
GEMINI_MODEL=gemini-flash-latest
